---
import Base from './Base.astro';
interface Props { title: string; description: string; noindex?: boolean; jsonLd?: any }
const { title, description, noindex, jsonLd } = Astro.props;
---
<Base title={title} description={description} noindex={noindex} jsonLd={jsonLd}>
  <article class="prose page">
    <h1>{title}</h1>
    <slot />
  </article>
</Base>
<style>
  .page h1 { font-size: clamp(2rem, 5vw, 2.7rem); margin-top: 8px; }
</style>
